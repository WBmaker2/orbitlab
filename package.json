{
  "name": "orbitlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OrbitLab — 3D Earth–Moon–Sun classroom simulator for seasons, phases, and eclipses",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert \"performance budget\" && playwright test src/tests/e2e/performance.spec.ts --workers=1",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
